    <changeSet id="4" author="any_author">
        <createTable tableName="employees" schemaName="management">
            <column autoIncrement="true" name="employee_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_employees"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="age" type="INTEGER"/>
            <column name="salary" type="DOUBLE PRECISION"/>
            <column name="skill" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="5" author="any_author">
        <createTable tableName="tasks">
            <column autoIncrement="true" name="task_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tasks"/>
            </column>
            <column name="task_description" type="VARCHAR(255)"/>
            <column name="difficulty" type="VARCHAR(255)"/>
            <column name="deadline" type="VARCHAR(255)"/>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Добавляем внешний ключ к таблице projects -->
        <addForeignKeyConstraint baseTableName="tasks"
                                 baseColumnNames="project_id"
                                 referencedTableName="projects"
                                 referencedColumnNames="project_id"
                                 constraintName="fk_task_project"/>

    </changeSet>


