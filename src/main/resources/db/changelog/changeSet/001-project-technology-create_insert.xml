<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="any_author">
        <createTable tableName="projects">
            <column autoIncrement="true" name="project_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_projects"/>
            </column>
            <column name="project_description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="project_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>



    <changeSet id="2" author="any_author">
        <createTable tableName="technologies">
            <column autoIncrement="true" name="technology_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_technologies"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    
    <changeSet id="3" author="any_author">
        <createTable tableName="project_technology">
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="technology_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>


        <addForeignKeyConstraint
                baseTableName="project_technology"
                baseColumnNames="project_id"
                referencedTableName="projects"
                referencedColumnNames="project_id"
                constraintName="fk_project_technology_project"/>

        <addForeignKeyConstraint
                baseTableName="project_technology"
                baseColumnNames="technology_id"
                referencedTableName="technologies"
                referencedColumnNames="technology_id"
                constraintName="fk_project_technology_technology"/>
    </changeSet>

